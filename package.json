{
  "name": "vde-tmux-manager",
  "version": "0.0.5",
  "description": "tmux utility CLI for session management and statusline helpers",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "types": "dist/index.d.mts",
  "bin": {
    "vde-tmux-manager": "./bin/vde-tmux-manager",
    "vtm": "./bin/vtm"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist coverage",
    "ci": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test",
    "dev": "tsdown --watch",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "pnpm build && vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --build --noEmit",
    "prepublishOnly": "pnpm clean && pnpm build"
  },
  "keywords": [
    "tmux",
    "cli",
    "session",
    "statusline"
  ],
  "author": "Yuki Yano",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuki-yano/vde-tmux-manager.git"
  },
  "bugs": {
    "url": "https://github.com/yuki-yano/vde-tmux-manager/issues"
  },
  "homepage": "https://github.com/yuki-yano/vde-tmux-manager#readme",
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^24.5.2",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.5",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "tsdown": "^0.20.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.1",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "citty": "^0.2.1",
    "string-width": "^8.2.0",
    "yaml": "^2.8.2"
  }
}
